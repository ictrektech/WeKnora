# Build frontend assets inside Docker so release builds do not depend on a
# pre-existing frontend/dist directory on the host.
FROM node:22-alpine AS builder

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG VITE_FRONTEND_COMMIT=unknown
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV VITE_FRONTEND_COMMIT=${VITE_FRONTEND_COMMIT}

COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/packages ./packages
RUN npm config set registry "${NPM_REGISTRY}" && npm ci

COPY frontend/ ./
COPY docs/api /docs/api
COPY website-docs/04-api /website-docs/04-api
RUN npm run build

FROM nginx:stable-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/templates/default.conf.template
# nginx.conf references the HTTP-context log format declared here. Keep this
# release Dockerfile in sync with frontend/Dockerfile so the generated server
# configuration can start successfully.
COPY frontend/nginx-http.conf /etc/nginx/conf.d/00-weknora-http.conf
COPY frontend/nginx-api-proxy.conf /etc/nginx/api-proxy.conf
COPY frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENV MAX_FILE_SIZE_MB=50

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
